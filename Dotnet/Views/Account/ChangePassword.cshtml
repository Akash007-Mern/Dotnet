@model Dotnet.Models.ChangePassword
@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<div class="max-w-md mx-auto mt-20">
    <div class="bg-white border border-gray-200 rounded-md shadow-sm p-6">
        <h2 class="text-lg font-semibold mb-2">Change Password</h2>
        <p class="text-sm text-gray-600 mb-4">Enter your current password and choose a new secure password.</p>

        <form asp-action="ChangePassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-3"></div>

            <div class="mb-4">
                <label asp-for="CurrentPassword" class="block text-sm font-medium text-gray-700">Current password</label>
                <input asp-for="CurrentPassword" type="password" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2" />
                <span asp-validation-for="CurrentPassword" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-4">
                <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700">New password</label>
                <input asp-for="NewPassword" type="password" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2" />
                <span asp-validation-for="NewPassword" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirm new password</label>
                <input asp-for="ConfirmPassword" type="password" class="mt-1 block w-full border border-gray-300 rounded-md px-3 py-2" />
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
            </div>

            <div class="flex items-center justify-between mt-6">
                <a asp-controller="Dashboard" asp-action="Index" class="text-sm text-gray-600">Cancel</a>
                <button type="submit" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md">Change password</button>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <script>
        Toastify({
            text: "@TempData["Success"]",
            duration: 3000,
            gravity: "top",
            position: "right",
            close: true,
            style: {
                background: "#16a34a"
            }
        }).showToast();
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Toastify({
            text: "@TempData["Error"]",
            duration: 4000,
            gravity: "top",
            position: "right",
            close: true,
            style: {
                background: "#dc2626"
            }
        }).showToast();
    </script>
}