@model ChangePassword
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_StaticLayout";
}

<div class="max-w-lg mx-auto mt-8 bg-white shadow-lg rounded-lg p-6">

    <form asp-action="ResetPassword" class="mb-4">
        <input type="text" asp-for="EmailAddress" />

        <div asp-validation-summary="ModelOnly" class="text-red-400 mb-4"></div>
        <div class="mb-4">
            <label asp-for="NewPassword" class="block mb-2 text-sm font-medium text-gray-700">
                New Password
            </label>

            <input asp-for="NewPassword"
                   type="password"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="Enter your Password" />

            <span asp-validation-for="NewPassword"
                  class="text-red-600 text-sm"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="block mb-2 text-sm font-medium text-gray-700">
                Confirm Password
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="Confirm your Password" />

            <span asp-validation-for="ConfirmPassword"
                  class="text-red-600 text-sm"></span>
        </div>
        <button type="submit"
                class="w-full bg-blue-600 text-white rounded-lg py-2 hover:bg-blue-700 transition">
            Submit
        </button>
    </form>
</div>